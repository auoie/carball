+		out.Write(ContactBodyKey(m->getBody0()));
+		out.Write(ContactBodyKey(m->getBody1()));
+		out.Write<int32_t>(m->getNumContacts());
+		for (int j = 0; j < m->getNumContacts(); j++)
+			WriteContactPoint(out, m->getContactPoint(j));
+	}
