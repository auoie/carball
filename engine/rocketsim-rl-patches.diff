+/*
+RL PATCH (RV-233): a copy of Bullet 3.24's btGjkEpa2.cpp for the demolition sweep only (SweepGjkEpa282.h): its
+implementation in namespace gjkepa2_282 (not gjkepa2_impl: the two copies' types differ), EPA_MAX_VERTICES 64 as Bullet
+2.82's, Distance and Penetration as SweepGjkEpa282's; then the penetration solver with 2.82's calcPenDepth
+*/
+
+/*
+GJK-EPA collision solver by Nathanael Presson, 2008
+*/
+#include "../../../libsrc/bullet3-3.24/BulletCollision/CollisionShapes/btConvexInternalShape.h"
+#include "../../../libsrc/bullet3-3.24/BulletCollision/CollisionShapes/btSphereShape.h"
