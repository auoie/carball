+		UEQuat q = UENormalized(UESlerpQuat({ qa.x(), qa.y(), qa.z(), qa.w() }, { qb.x(), qb.y(), qb.z(), qb.w() }, f));
+		impacts[i]->rotMat = UEQuatRotMat(q);
+	}
+	return f;
+}
