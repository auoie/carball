diff --git engine/rocketsim/src/Sim/GameRotator/GameRotator.h engine/rocketsim/src/Sim/GameRotator/GameRotator.h
new file mode 100644
index 0000000..7c6f812
--- /dev/null
+++ engine/rocketsim/src/Sim/GameRotator/GameRotator.h
@@ -0,0 +1,119 @@
+#pragma once
+// RL PATCH: the game's rotators (UE3 FRotator, 65536 units a turn) as its car scripts use them: QuatToRotator
+// (execQuatToRotator 0x140364b80: the quaternion's matrix, then FMatrix::Rotator 0x140385e40: atan2f, appRound) and
+// GetRotatorAxis / Vector(R) / the cone's matrix (FRotationTranslationMatrix 0x140369b10: the 16384-entry sine table
+// FGlobalMath::TrigFLOAT at 0x142370780, filled by 0x140374fb0 with sinf((i + i) * 3.1415927f * (1 / 16384.f)))
+#include "../../Math/MathTypes/MathTypes.h"
+#include <cmath>
+
+RS_NS_START
+
+struct GameRotator { int pitch = 0, yaw = 0, roll = 0; };
+
+inline int UERound(float f) { return (int)lrintf(f + f + 0.5f) >> 1; } // (int)ROUND(f + f + 0.5) >> 1
+
+inline float UESinTab(int angle) {
+	static float* table = [] {
+		static float t[16384];
+		for (int i = 0; i < 16384; i++) {
+			float a = (float)i;
+			a = a + a;
+			a = a * 3.1415927f;
+			a = a * 6.1035156e-05f;
+			t[i] = det_sinf(a);
+		}
+		return t;
+	}();
+	return table[(angle >> 2) & 0x3fff];
+}
+
+// FRotationTranslationMatrix(R): rows X (forward), Y (right), Z (up), as RotMat's forward/right/up
+inline RotMat UERotationMatrix(const GameRotator& r) {
+	float SR = UESinTab(r.roll), SP = UESinTab(r.pitch), SY = UESinTab(r.yaw);
+	float CR = UESinTab(r.roll + 0x4000), CP = UESinTab(r.pitch + 0x4000), CY = UESinTab(r.yaw + 0x4000);
+	RotMat m;
+	m.forward = Vec(CY * CP, CP * SY, SP);
+	m.right = Vec(SP * SR * CY - CR * SY, CY * CR + SP * SR * SY, -SR * CP);
+	m.up = Vec(-(CR * SP * CY + SY * SR), CY * SR - CR * SP * SY, CP * CR);
+	return m;
+}
+
+// FMatrix::Rotator() of a rotation's axes (X = forward, Y = right, Z = up)
+inline GameRotator UERotatorFromMatrix(const RotMat& m) {
+	const Vec &X = m.forward, &Y = m.right, &Z = m.up;
+	GameRotator r;
+	float yaw = det_atan2f(X.y, X.x);
+	yaw = (yaw * 32768.0f) / 3.1415927f;
+	float s = X.y * X.y + X.x * X.x;
+	float pitch = det_atan2f(X.z, (float)sqrt((double)s));
+	pitch = (pitch * 32768.0f) / 3.1415927f;
+	r.pitch = UERound(pitch);
+	r.yaw = UERound(yaw);
+	r.roll = 0;
+	Vec SYa = UERotationMatrix(r).right;
+	float roll = det_atan2f(Z.y * SYa.y + Z.x * SYa.x + Z.z * SYa.z, Y.y * SYa.y + Y.x * SYa.x + Y.z * SYa.z);
+	roll = (roll * 32768.0f) / 3.1415927f;
+	r.roll = UERound(roll);
+	return r;
+}
+
+// The axes the game's scripts see for a body rotation: Rotation(QuatToRotator(q)) through the sine table
+inline RotMat GameRotatorBasis(const RotMat& m) { return UERotationMatrix(UERotatorFromMatrix(m)); }
+
+// RL PATCH (RV-232): UE3's quaternion maths where the game's car scripts take a rotator from a quaternion
+// (QuatToRotator, GetTimeOfImpact FUN_140f01930)
+struct UEQuat { float x = 0, y = 0, z = 0, w = 1; };
+
+// FQuat SlerpQuat (0x140388840): the dot ((y1y2 + x1x2) + z1z2) + w1w2; at |dot| >= 0.9999 linear (1 - t, t), else
+// through acos and sin; b's weight negated when the dot is negative
+inline UEQuat UESlerpQuat(const UEQuat& a, const UEQuat& b, float t) {
+	float raw = a.y * b.y + a.x * b.x + a.z * b.z + a.w * b.w;
+	float cosom = raw < 0 ? -raw : raw;
+	float s0, s1;
+	if (cosom < 0.9999f) {
+		float omega = det_acosf(cosom > 1.f ? 1.f : cosom);
+		float invSin = 1.f / det_sinf(omega);
+		s0 = det_sinf((1.f - t) * omega) * invSin;
+		s1 = det_sinf(omega * t) * invSin;
+	} else {
+		s0 = 1.f - t;
+		s1 = t;
+	}
+	if (raw < 0)
+		s1 = -s1;
+	return { s1 * b.x + a.x * s0, s1 * b.y + a.y * s0, s1 * b.z + a.z * s0, s1 * b.w + a.w * s0 };
+}
+
+// GetTimeOfImpact's normalisation: the sum ((x2 + y2) + z2) + w2 over 1e-8 times 1 / sqrt, else the identity
+inline UEQuat UENormalized(const UEQuat& q) {
+	float sum = q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w;
+	if (!(sum > 1e-8f))
+		return {};
+	float s = 1.f / sqrtf(sum);
+	return { q.x * s, s * q.y, s * q.z, s * q.w };
+}
+
+// FQuatRotationTranslationMatrix (0x14036f9c0: x2 = x + x, ...): the matrix QuatToRotator hands FMatrix::Rotator
+// (Bullet's basis from a quaternion scales by 2 / |q|^2: a rotator off by a unit in about 0.05 % of cases)
+inline RotMat UEQuatRotMat(const UEQuat& q) {
+	float x2 = q.x + q.x, y2 = q.y + q.y, z2 = q.z + q.z;
+	float xx = x2 * q.x, yy = y2 * q.y, zz = z2 * q.z;
+	float xy = y2 * q.x, xz = z2 * q.x, yz = z2 * q.y;
+	float wx = x2 * q.w, wy = y2 * q.w, wz = z2 * q.w;
+	RotMat m;
+	m.forward = Vec(1.f - (zz + yy), wz + xy, xz - wy);
+	m.right = Vec(xy - wz, 1.f - (zz + xx), wx + yz);
+	m.up = Vec(wy + xz, yz - wx, 1.f - (yy + xx));
+	return m;
+}
+
+// The cone's hitbox centre (FUN_140f11c30): the location plus the offset multiplied by the rotator matrix's rows,
+// (off . X, off . Y, off . Z): the transpose of the rotation (InverseTransformNormal), not R * off
+inline Vec GameConeCentre(const Vec& pos, const RotMat& rm, const Vec& off) {
+	return Vec(off.y * rm.forward.y + off.x * rm.forward.x + off.z * rm.forward.z + pos.x,
+	           off.y * rm.right.y + off.x * rm.right.x + off.z * rm.right.z + pos.y,
+	           off.y * rm.up.y + off.x * rm.up.x + off.z * rm.up.z + pos.z);
+}
+
+
+RS_NS_END
diff --git engine/rocketsim/src/Sim/PhysState/RawBodyState.h engine/rocketsim/src/Sim/PhysState/RawBodyState.h
new file mode 100644
index 0000000..5830392
--- /dev/null
+++ engine/rocketsim/src/Sim/PhysState/RawBodyState.h
@@ -0,0 +1,84 @@
+#pragma once
+#include "../../BaseInc.h"
+#include "../../DataStream/DataStreamIn.h"
+#include "../../DataStream/DataStreamOut.h"
+
+#include "../../../libsrc/bullet3-3.24/BulletDynamics/Dynamics/btRigidBody.h"
+#include "../Quantize/Quantize.h"
+
+RS_NS_START
+
+// RL PATCH: a rigid body's exact state, in Bullet units. CarState and BallState hold game units, and
+// converting back (x 0.02) does not always give the same float, so snapshots carry these too: a restored
+// arena then continues bit for bit like the original.
+struct RawBodyState {
+	float origin[3] = {}, basis[9] = {}, linVel[3] = {}, angVel[3] = {};
+	// The world inverse inertia tensor as it is (it isn't recomputed from the rotation each tick: see Quantize)
+	float invInertia[9] = {};
+	int32_t activationState = 0;
+	float deactivationTime = 0;
+	Quantize::PackedRotation netRotation; // the rotation as last quantized (what the network sends)
+
+	static RawBodyState From(const btRigidBody& rb, const Quantize::PackedRotation& netRotation) {
+		RawBodyState s;
+		s.netRotation = netRotation;
+		const btTransform& t = rb.getWorldTransform();
+		for (int i = 0; i < 3; i++) {
+			s.origin[i] = t.getOrigin()[i];
+			s.linVel[i] = rb.getLinearVelocity()[i];
+			s.angVel[i] = rb.getAngularVelocity()[i];
+			for (int j = 0; j < 3; j++) {
+				s.basis[i * 3 + j] = t.getBasis()[i][j];
+				s.invInertia[i * 3 + j] = rb.m_invInertiaTensorWorld[i][j];
+			}
+		}
+		s.activationState = rb.getActivationState();
+		s.deactivationTime = rb.getDeactivationTime();
+		return s;
+	}
+
+	void ApplyTo(btRigidBody& rb, Quantize::PackedRotation& netRotationOut) const {
+		netRotationOut = netRotation;
+		btTransform t;
+		t.setOrigin(btVector3(origin[0], origin[1], origin[2]));
+		t.setBasis(btMatrix3x3(basis[0], basis[1], basis[2], basis[3], basis[4], basis[5], basis[6], basis[7], basis[8]));
+		rb.setWorldTransform(t);
+		rb.setInterpolationWorldTransform(t);
+		rb.setLinearVelocity(btVector3(linVel[0], linVel[1], linVel[2]));
+		rb.setAngularVelocity(btVector3(angVel[0], angVel[1], angVel[2]));
+		rb.setInterpolationLinearVelocity(rb.getLinearVelocity());
+		rb.setInterpolationAngularVelocity(rb.getAngularVelocity());
+		rb.m_invInertiaTensorWorld = btMatrix3x3(invInertia[0], invInertia[1], invInertia[2], invInertia[3], invInertia[4],
+			invInertia[5], invInertia[6], invInertia[7], invInertia[8]);
+		rb.forceActivationState(activationState);
+		rb.setDeactivationTime(deactivationTime);
+	}
+
+	void Serialize(DataStreamOut& out) const {
+		for (float f : origin) out.Write(f);
+		for (float f : basis) out.Write(f);
+		for (float f : linVel) out.Write(f);
+		for (float f : angVel) out.Write(f);
+		for (float f : invInertia) out.Write(f);
+		out.Write(activationState);
+		out.Write(deactivationTime);
+		out.Write(netRotation.largest);
+		for (uint32_t c : netRotation.c) out.Write(c);
+		out.Write(netRotation.valid);
+	}
+
+	void Deserialize(DataStreamIn& in) {
+		for (float& f : origin) in.Read(f);
+		for (float& f : basis) in.Read(f);
+		for (float& f : linVel) in.Read(f);
+		for (float& f : angVel) in.Read(f);
+		for (float& f : invInertia) in.Read(f);
+		in.Read(activationState);
+		in.Read(deactivationTime);
+		in.Read(netRotation.largest);
+		for (uint32_t& c : netRotation.c) in.Read(c);
+		in.Read(netRotation.valid);
+	}
+};
+
+RS_NS_END
diff --git engine/rocketsim/src/Sim/Quantize/Quantize.cpp engine/rocketsim/src/Sim/Quantize/Quantize.cpp
new file mode 100644
index 0000000..ae9872d
--- /dev/null
+++ engine/rocketsim/src/Sim/Quantize/Quantize.cpp
@@ -0,0 +1,169 @@
+#include "Quantize.h"
+
+#include "../../BulletLink.h"
+#include "../../../libsrc/bullet3-3.24/BulletDynamics/Dynamics/btRigidBody.h"
+
+#include <cmath>
+
+RS_NS_START
+
+namespace Quantize {
+	int8_t InputAxisByte(float v) {
+		v = RS_CLAMP(v, -1.f, 1.f);
+		float f = v < 0 ? RS_MAX(v * 128.f, -128.f) : RS_MIN(v * 127.f, 127.f);
+		float y = f + 128.f;
+		int b = (int)nearbyintf(y + y + 0.5f) >> 1; // (cvtss2si: round half to even)
+		return (int8_t)(b - 128);
+	}
+
+	float InputAxisValue(int8_t q) {
+		float v = (float)q;
+		return q < 0 ? v * 0.0078125f : v / 127.f;
+	}
+
+	constexpr int ROT_BITS = 18;
+	constexpr int ROT_MAX = (1 << ROT_BITS) - 1;
+
+	int RoundUE(float x) {
+		// appRound: cvtss2si(x + x + 0.5) >> 1 (round half up)
+		return (int)lrintf(x + x + 0.5f) >> 1;
+	}
+
+	float Location(float x) {
+		constexpr float SCALE = 100.f;
+		return (1.f / SCALE) * (float)RoundUE(SCALE * x);
+	}
+
+	float Velocity(float v, float scale) {
+		float invScale = 1.f / scale;
+		float result = invScale * (float)(int)(scale * v);
+		float sign = (result > 0) ? 1.f : ((result < 0) ? -1.f : 0.f);
+		return sign * (invScale * 0.1f) + result;
+	}
+
+	btQuaternion Unpack(const PackedRotation& packed) {
+		int largest = packed.largest;
+		float out[4];
+		for (int i = 0, j = 0; i < 4; i++) {
+			if (i == largest)
+				continue;
+			float f = (float)packed.c[j++] / (float)ROT_MAX - 0.5f;
+			out[i] = (f + f) * 0.70710677f;
+		}
+		{
+			float rest = 1.f;
+			for (int i = 0; i < 4; i++)
+				if (i != largest)
+					rest -= out[i] * out[i];
+			out[largest] = (float)sqrt((double)RS_MAX(rest, 0.f));
+		}
+
+		float lengthSq = out[0] * out[0] + out[1] * out[1] + out[2] * out[2] + out[3] * out[3];
+		if (lengthSq <= 1e-8f)
+			return btQuaternion(0, 0, 0, 1);
+		float invLength = 1.f / sqrtf(lengthSq);
+		return btQuaternion(out[0] * invLength, out[1] * invLength, out[2] * invLength, out[3] * invLength);
+	}
+
+	btQuaternion Rotation(const btQuaternion& qIn, PackedRotation* packedOut) {
+		// Normalize (identity if degenerate)
+		float q[4] = { qIn.x(), qIn.y(), qIn.z(), qIn.w() };
+		float lengthSq = q[1] * q[1] + q[0] * q[0] + q[2] * q[2] + q[3] * q[3];
+		if (lengthSq > 1e-8f) {
+			float invLength = 1.f / sqrtf(lengthSq);
+			for (float& c : q)
+				c *= invLength;
+		} else {
+			q[0] = q[1] = q[2] = 0;
+			q[3] = 1;
+		}
+
+		// Index of the largest component (ties: x over y, z over w, the x/y pair over the z/w pair)
+		int bestXY = (fabsf(q[0]) < fabsf(q[1])) ? 1 : 0;
+		int bestZW = (fabsf(q[2]) < fabsf(q[3])) ? 3 : 2;
+		int largest = (fabsf(q[bestZW]) <= fabsf(q[bestXY])) ? bestXY : bestZW;
+
+		// Compress the other three, flipped so the dropped component is positive
+		float sign = (q[largest] < 0) ? -1.f : 1.f;
+		PackedRotation packed;
+		packed.largest = (uint8_t)largest;
+		packed.valid = true;
+		for (int i = 0, j = 0; i < 4; i++) {
+			if (i == largest)
+				continue;
+			float val = (q[i] * sign * 1.4142135f * 0.5f + 0.5f) * (float)ROT_MAX;
+			packed.c[j++] = (uint32_t)RS_CLAMP(RoundUE(val), 0, ROT_MAX);
+		}
+		if (packedOut)
+			*packedOut = packed;
+
+		return Unpack(packed);
+	}
+
+	// RL PATCH: the game's speed cap in its read-back of the body (FUN_140eed9e0), in uu after the x50: the squared
+	// length summed y, x, z; strictly over the cap, the components times the inverse square root, then times the cap
+	// (left as they are at length 1, zero below 1e-8) (static analysis RS-5)
+	static void CapReadBack(btVector3& v, float max) {
+		if (!(max > 0))
+			return;
+		float x = v.x(), y = v.y(), z = v.z();
+		float lengthSq = y * y + x * x + z * z;
+		if (!(max * max < lengthSq))
+			return;
+		if (lengthSq == 1.f) {
+			// (unchanged)
+		} else if (lengthSq >= 1e-8f) {
+			float inv = 1.f / sqrtf(lengthSq);
+			x = inv * x;
+			y = inv * y;
+			z = inv * z;
+		} else {
+			x = y = z = 0;
+		}
+		v = btVector3(max * x, max * y, max * z);
+	}
+
+	void QuantizeVelocities(btRigidBody& rb, float maxSpeed, float maxAngSpeed) {
+		int activationState = rb.getActivationState();
+		if (activationState == ISLAND_SLEEPING || activationState == DISABLE_SIMULATION) {
+			rb.m_linearVelocity = btVector3(0, 0, 0);
+			rb.m_angularVelocity = btVector3(0, 0, 0);
+		} else {
+			btVector3 vel = rb.m_linearVelocity * BT_TO_UU;
+			btVector3 angVel = rb.m_angularVelocity;
+			ReadBackVelocities(vel, angVel, maxSpeed, maxAngSpeed);
+			rb.m_linearVelocity = vel * UU_TO_BT;
+			rb.m_angularVelocity = angVel;
+		}
+	}
+
+	void ReadBackVelocities(btVector3& vel, btVector3& angVel, float maxSpeed, float maxAngSpeed) {
+		CapReadBack(vel, maxSpeed);
+		CapReadBack(angVel, maxAngSpeed);
+		for (int i = 0; i < 3; i++) {
+			vel[i] = Velocity(vel[i], 100.f);
+			angVel[i] = Velocity(angVel[i], 10000.f);
+		}
+	}
+
+	void QuantizeRigidBody(btRigidBody& rb, PackedRotation* packedRotation, float maxSpeed, float maxAngSpeed) {
+		btTransform& transform = rb.getWorldTransform();
+
+		btVector3 pos = transform.getOrigin() * BT_TO_UU;
+		for (int i = 0; i < 3; i++)
+			pos[i] = Location(pos[i]);
+		transform.setOrigin(pos * UU_TO_BT);
+
+		btQuaternion rot;
+		transform.getBasis().getRotation(rot);
+		transform.setBasis(btMatrix3x3(Rotation(rot, packedRotation)));
+
+		QuantizeVelocities(rb, maxSpeed, maxAngSpeed);
+
+		// RL PATCH: no inertia refresh: the game's write-back (FUN_140f2fb50) sets the position, the rotation and the
+		// velocities only, so the world inverse inertia tensor stays as the step's integration left it (from the
+		// rotation before this rounding). RocketSim (and our patch 12) recomputed it here (static analysis RS-1)
+	}
+}
+
+RS_NS_END
diff --git engine/rocketsim/src/Sim/Quantize/Quantize.h engine/rocketsim/src/Sim/Quantize/Quantize.h
new file mode 100644
index 0000000..4c9bb13
--- /dev/null
+++ engine/rocketsim/src/Sim/Quantize/Quantize.h
@@ -0,0 +1,57 @@
+#pragma once
+#include "../../BaseInc.h"
+
+class btRigidBody;
+class btQuaternion;
+
+RS_NS_START
+
+// RL PATCH: Rocket League's per-tick physics state quantization (PhysicsConfig_TA.bQuantizePhysics).
+// After every physics tick each body's state goes through the network serializer and back
+// (FUN_140eed9e0 -> FUN_140e45c10 -> FUN_140e3e960), so the simulation only ever continues from
+// states a client could receive exactly.
+namespace Quantize {
+	// An input axis as Vehicle_TA.SetVehicleInput stores it (FUN_140f30a70): a byte 128 + q with q = round(v × 127)
+	// for v >= 0 and round(v × 128) below (half up), read back as q / 127 or q × (1/128). Every axis the physics
+	// reads goes through this, on the server and for the local player.
+	int8_t InputAxisByte(float v); // q, -128..127
+	float InputAxisValue(int8_t q);
+	inline float InputAxis(float v) { return InputAxisValue(InputAxisByte(v)); }
+
+	// UE3 appRound(): floor(x + 0.5), computed the same way as the game
+	int RoundUE(float x);
+
+	// Location in uu: nearest 0.01 (FUN_140380930, scale 100)
+	float Location(float x);
+
+	// Velocity component: truncated at 1/scale, then nudged 0.1/scale away from zero (FUN_140380a00).
+	// Scale 100 for linear velocity (uu/s), 10000 for angular velocity (rad/s)
+	float Velocity(float v, float scale);
+
+	// A rotation as the network sends it: the index of the dropped (largest) component and the other three in 18 bits.
+	// Kept per body after each tick, because recompressing the resulting rotation matrix is not always exact.
+	struct PackedRotation {
+		uint8_t largest = 0;
+		uint32_t c[3] = {};
+		bool valid = false; // false after a state was set directly (not by a tick)
+	};
+
+	// Rotation: "smallest three" quaternion, 18 bits per component (FUN_14037bf60 / FUN_1403738b0 / FUN_140380140)
+	btQuaternion Rotation(const btQuaternion& q, PackedRotation* packed = nullptr);
+
+	// The rotation a packed rotation stands for (the decompression half of Rotation())
+	btQuaternion Unpack(const PackedRotation& packed);
+
+	// Applies all of the above to a Bullet rigid body (Bullet units are uu / 50)
+	// `maxSpeed` (uu/s) and `maxAngSpeed` (rad/s): the body's caps, applied as the game's read-back does (0: none)
+	void QuantizeRigidBody(btRigidBody& rb, PackedRotation* packedRotation = nullptr, float maxSpeed = 0, float maxAngSpeed = 0);
+
+	// The velocities' part of it alone (the position and rotation already rounded: re-rounding a rotation isn't always
+	// exact): a body pushed between ticks, read back as the game's next physics frame reads it (RV-231)
+	void QuantizeVelocities(btRigidBody& rb, float maxSpeed, float maxAngSpeed);
+
+	// The read-back's velocities: `vel` in uu/s and `angVel` in rad/s capped, then quantised (QuantizeVelocities' maths)
+	void ReadBackVelocities(btVector3& vel, btVector3& angVel, float maxSpeed, float maxAngSpeed);
+}
+
+RS_NS_END
