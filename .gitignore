# --- Game-derived material: never commit ---------------------------------
# Decrypted/decompressed Rocket League packages (copyrighted game data, ~370 MB)
out/decrypted/
# Package decryption key
out/rlupktool_key.bin
*.key

# Ghidra project database (embeds the full RocketLeague.exe, ~600 MB; its .lock files live in ghidra/ too)
ghidra/
*.gpr
*.rep/

# Arena collision meshes extracted for local measurement only (Psyonix geometry)
out/arena_local/

# Experimental arena variants (scripts/arena_gen.py OUTDIR; regenerable). out/arena is the one the game uses.
out/arena_*/

# Decompiled game code (derived from the exe; regenerate with scripts/Decomp.java)
out/decomp/
out/decomp_tokens/
out/sub57.txt

# Rocket League replays (third-party dataset; contain player names)
*.replay

# --- Regenerable / noise ---------------------------------------------------
logs/
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
# Claude Code's per-user settings (the shared .claude/settings.json can be committed)
.claude/settings.local.json

# replay extractor build output
scripts/replay_extract/target/

# engine build output
engine/build/
engine/build-wasm/
engine/rocketsim/build/

# JavaScript dependencies (web client)
node_modules/

# web client build and test output
client/dist/
client/test-results/
client/playwright-report/

# game server build output
server/target/

# Replays pulled from the dataset and data extracted from them (third-party; player data)
out/replays/
